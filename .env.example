# ============================================================
# MaatruMitra — Local Development Environment Variables
# Copy this file to .env and fill in real values.
# Never commit the actual .env file.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=localhost

# --- Database ---
# SQLite (default for local dev). Use an absolute or relative path.
# For PostgreSQL: postgres://user:pass@localhost:5432/maatrumitra
DATABASE_URL=./dev.sqlite

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Cookie settings
COOKIE_SECURE=false       # set to true in production (HTTPS only)
COOKIE_SAME_SITE=lax      # strict | lax | none

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- File storage (local filesystem for dev) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400   # 25 MB
ALLOWED_MIME_TYPES=audio/webm,audio/ogg,audio/wav,audio/mp4,audio/mpeg,audio/flac

# --- Rate limiting ---
AUTH_RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_WINDOW_MS=300000 # 5 minutes
UPLOAD_RATE_LIMIT_MAX=10

# --- AI provider (leave blank to use deterministic fake provider in dev) ---
# STT_PROVIDER=fake
# STT_API_KEY=
# STT_API_BASE_URL=

# EXTRACTION_PROVIDER=fake
# EXTRACTION_API_KEY=

# --- Analytics (optional, Umami-compatible) ---
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- OAuth (not used in this stage) ---
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=
